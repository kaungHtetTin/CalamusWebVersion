# SPA: serve index.html for routes so refresh keeps you on the current page. Never rewrite static assets.
Options -MultiViews
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Do NOT rewrite requests for static files (avoids "Unexpected token '<'" for .js/.json)
  RewriteCond %{REQUEST_URI} \.(js|css|json|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map|webp)$ [NC]
  RewriteRule ^ - [L]
  # Serve existing files and directories as-is
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # Send route requests to index.html so React Router can show the current page
  RewriteRule ^ index.html [QSA,L]
</IfModule>
